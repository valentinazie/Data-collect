# 메모리
max by (pod) (container_memory_working_set_bytes{namespace="ai", pod=~"milvus844-querycoord.*", container!="", container!="POD"})

# CPU 사용량과 제한(throttling) - 메모리 전에 CPU가 막혀 처리가 밀렸는지
sum by (pod) (rate(container_cpu_usage_seconds_total{namespace="ai", pod=~"milvus844-querycoord.*", container!=""}[5m]))
sum by (pod) (rate(container_cpu_cfs_throttled_periods_total{namespace="ai", pod=~"milvus844-querycoord.*"}[5m]))

# 이전에도 재시작이나 OOM이 있었는지
increase(kube_pod_container_status_restarts_total{namespace="ai", pod=~"milvus844-querycoord.*"}[14d])
