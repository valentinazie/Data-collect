# 재시작 횟수, 기동 시간
oc -n ai get pod | grep milvus72-kafka

# 현재 메모리, 한도
oc -n ai adm top pod | grep milvus72-kafka
oc -n ai get pod ibm-lh-lakehouse-milvus72-kafka-2 -o jsonpath='{.spec.containers[*].resources}{"\n"}'

# 최근 로그에서 OOM, GC 경고
oc -n ai logs ibm-lh-lakehouse-milvus72-kafka-2 --since=6h | grep -iE 'outofmemory|gc overhead|pause' | tail -20

# 최근 6시간 컨테이너 메모리 추이 (1시간 간격, MiB)
POD='.*milvus72-kafka.*'
promr "max by (pod)(max_over_time(container_memory_working_set_bytes{namespace=\"ai\",pod=~\"$POD\",container!=\"\",container!=\"POD\"}[1h]))" $(date -u -d '-6 hour' +%Y-%m-%dT%H:00:00Z) $(date -u +%Y-%m-%dT%H:00:00Z) 3600 1048576
